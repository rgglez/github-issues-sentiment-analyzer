# Public site key (baked into the client; safe to expose).
PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here

# Secret key for local vite/dev only. Production uses:
#   pnpm exec wrangler secret put RECAPTCHA_SECRET_KEY
# and local wrangler/preview uses .dev.vars (same name).
RECAPTCHA_SECRET_KEY=your_secret_key_here
