{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "github-issues-sentiment-classifier",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "MODELS",
			"bucket_name": "github-issues-sentiment-models"
		}
	],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": true
}
